---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectUrl, categoryUrl, formatDate } from '../../data/portfolio';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const related = projects.filter(item=>item.slug!==project.slug && (project.family && item.family===project.family || item.categoryId===project.categoryId)).sort((a,b)=>Number(!!project.family && b.family===project.family)-Number(!!project.family && a.family===project.family)).slice(0,3);
---
<Base title={project.title+' — Siva Babu'} description={project.description} active="projects">
  <section class="detail-header container"><div class="breadcrumbs"><a href={base+'projects/'}>Projects</a><span>/</span><a href={categoryUrl(base,project.categoryId)}>{project.categoryShort}</a></div><div class="detail-header-grid"><div><span class="format-label">{project.format}</span><h1>{project.title}</h1><p>{project.description}</p><ul class="project-tags" aria-label="Project topics">{project.tags.map(tag=><li>{tag}</li>)}</ul></div><div class="detail-header-actions"><a href={project.repository} class="button button-primary" target="_blank" rel="noopener noreferrer">View on GitHub <Arrow diagonal/></a>{project.demo && <a href={project.demo} class="button button-secondary" target="_blank" rel="noopener noreferrer">{project.demoLabel} <Arrow diagonal/></a>}</div></div></section>
  {project.image && <figure class="container detail-image"><img src={base+'images/'+project.image} alt={project.imageKind+' for '+project.title} width={project.imageWidth} height={project.imageHeight}/><figcaption>{project.imageKind} · from the project repository</figcaption></figure>}
  <section class="container detail-body"><aside><p class="sidebar-title">PROJECT AT A GLANCE</p><dl><div><dt>Area</dt><dd><a href={categoryUrl(base,project.categoryId)}>{project.category}</a></dd></div><div><dt>Format</dt><dd>{project.format}</dd></div>{project.family && <div><dt>Collection</dt><dd>{project.family}</dd></div>}<div><dt>Primary repository language</dt><dd>{project.language}</dd></div><div><dt>Last repository update</dt><dd>{formatDate(project.updatedAt)}</dd></div></dl></aside><div class="detail-prose"><section><p class="eyebrow">THE IDEA</p><h2>What it’s about.</h2><p>{project.overview}</p>{project.why!==project.description && <p>{project.why}</p>}</section>{project.capabilities.length>0 && <section><p class="eyebrow">GO A LITTLE DEEPER</p><h2>What you can explore.</h2><div class="capability-list">{project.capabilities.map(capability=><div><h3>{capability.title}</h3><p>{capability.text}</p></div>)}</div></section>}<section><p class="eyebrow">USEFUL CONTEXT</p><h2>Know the scope.</h2><p>{project.scope}</p></section><section><p class="eyebrow">FOLLOW THE WORK</p><h2>Start with the source.</h2><p>The README is the best place for setup, current behavior, and the details behind this project.</p><div class="documentation-links"><a href={project.repository} target="_blank" rel="noopener noreferrer"><span>Project README & source code</span><Arrow diagonal/></a>{project.notes.filter(note=>note.url!==project.repository).map(note=><a href={note.url} target="_blank" rel="noopener noreferrer"><span>{note.title}</span><Arrow diagonal/></a>)}</div></section></div></section>
  {related.length>0 && <section class="container related-section"><div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related projects.</h2></div><a href={categoryUrl(base,project.categoryId)} class="text-link">More in {project.categoryShort}<Arrow/></a></div><div class="related-grid">{related.map(item=><ProjectCard project={item}/>)}</div></section>}
</Base>

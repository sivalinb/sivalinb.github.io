---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ProjectArt from "../components/ProjectArt.astro";
import SystemMap from "../components/SystemMap.astro";
import { profile, projects, categories, notes } from "../data/portfolio";
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero section-grid">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="mini-line"></span> THE PORTFOLIO OF SIVA BABU</p>
        <h1>Complex systems.<br /><span>Clear signals.</span></h1>
        <p class="hero-description">{profile.introduction}</p>
        <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <Arrow /></a><a class="button button-quiet" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal /></a></div>
        <div class="hero-footnote"><span class="small-cross">+</span> Observability · GPU infrastructure · LLM serving</div>
      </div>
      <SystemMap />
    </div>
    <div class="container hero-index"><span>01 — SELECTED WORK</span><a href="#work">Scroll to explore <span>↓</span></a><span>PUBLIC PROJECTS / OPEN CODE</span></div>
  </section>
  <section id="work" class="section work-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">WORK YOU CAN EXPLORE</p><h2>A few things I’ve built.</h2></div><p>Tools, experiments, and workbenches.<br />The code and context are one click away.</p></div>
      <div class="filter-row"><div class="project-filters" role="group" aria-label="Filter projects">{categories.map((category, index) => <button class:list={["filter-button", { active: index === 0 }]} data-filter={category} aria-pressed={index === 0 ? "true" : "false"}>{category}</button>)}</div><span id="project-count" class="project-count" role="status" aria-live="polite">04 PROJECTS</span></div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class:list={["project-card", "accent-" + project.accent, { "featured-project": index === 0, "wide-project": index === 3 }]} data-category={project.category}>
            <a class="project-art-link" href={base + "projects/" + project.slug + "/"} tabindex="-1" aria-hidden="true"><ProjectArt motif={project.motif} /></a>
            <div class="project-body">
              <div class="project-meta"><span>{project.category}</span><span>{project.number} /</span></div>
              <h3><a href={base + "projects/" + project.slug + "/"}>{project.title}</a></h3>
              <p>{project.description}</p>
              <ul class="tags" aria-label="Project topics">{project.tags.map(tag => <li>{tag}</li>)}</ul>
              <div class="project-links"><a href={base + "projects/" + project.slug + "/"}>Explore project <Arrow /></a><a href={project.repository} target="_blank" rel="noopener noreferrer" aria-label={"View " + project.title + " source on GitHub"}>Source <Arrow diagonal size={15} /></a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="approach-section">
    <div class="container approach-inner">
      <div><p class="eyebrow">A THREAD THROUGH THE WORK</p><h2>Make the invisible<br />understandable.</h2></div>
      <div class="approach-steps">
        <div><span class="step-number">01</span><h3>Observe</h3><p>Surface the events, metrics, and moving parts of a system.</p></div>
        <div><span class="step-number">02</span><h3>Explain</h3><p>Connect each signal with the context needed to interpret it.</p></div>
        <div><span class="step-number">03</span><h3>Verify</h3><p>Make the evidence and the limits easy to inspect.</p></div>
      </div>
    </div>
  </section>
  <section id="notes" class="section notes-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">BEHIND THE PROJECTS</p><h2>Read a little deeper.</h2></div><p>Architecture, walkthroughs, and notes<br />from the project repositories.</p></div>
      <div class="notes-list">{notes.map((note, i) => <a href={note.url} target="_blank" rel="noopener noreferrer" class="note-row"><span class="note-number">0{i+1}</span><div><span class="eyebrow note-topic">{note.topic}</span><h3>{note.title}</h3><p>{note.text}</p></div><span class="note-open"><Arrow diagonal size={22} /></span></a>)}</div>
    </div>
  </section>
  <section id="about" class="section about-section">
    <div class="container about-inner">
      <div class="about-mark" aria-hidden="true"><span>SB</span><div class="about-orbit"></div><span class="about-label">ALWAYS CURIOUS.</span></div>
      <div class="about-copy"><p class="eyebrow">THE PERSON BEHIND THE PROJECTS</p><h2>Hi, I’m {profile.name}.</h2><p>{profile.about}</p><p class="about-secondary">Start with a project that interests you. Each page links to the source, documentation, and the details behind the work.</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">More on GitHub <Arrow diagonal /></a></div>
    </div>
  </section>
  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
    const count = document.querySelector("#project-count");
    const grid = document.querySelector(".project-grid");
    filters.forEach((filter) => {
      filter.addEventListener("click", () => {
        const category = filter.dataset.filter;
        let visible = 0;
        filters.forEach(button => {
          const selected = button === filter;
          button.setAttribute("aria-pressed", String(selected));
          button.classList.toggle("active", selected);
        });
        cards.forEach(card => {
          const show = category === "All projects" || card.dataset.category === category;
          card.hidden = !show;
          if (show) visible++;
        });
        if (count) count.textContent = String(visible).padStart(2, "0") + (visible === 1 ? " PROJECT" : " PROJECTS");
        grid?.classList.toggle("is-filtered", category !== "All projects");
        grid?.classList.toggle("is-single", visible === 1);
      });
    });
  </script>
</Base>

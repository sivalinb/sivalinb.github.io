---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects, featuredProjects, categories, categoryUrl } from '../data/portfolio';
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="home-hero container">
    <div class="home-hero-copy"><p class="eyebrow"><span class="status-dot"></span> A PORTFOLIO BY SIVA BABU</p><h1>Things I build.<br/><em>Ideas I explore.</em></h1><p>{profile.introduction}</p><div class="hero-actions"><a href={base+'projects/'} class="button button-primary">Explore all projects <span class="button-count">{projects.length}</span><Arrow/></a><a href={profile.github} class="text-link" target="_blank" rel="noopener noreferrer">Find me on GitHub <Arrow diagonal size={16}/></a></div></div>
    <div class="interest-map"><p class="interest-title">Start with what interests you.</p><nav aria-label="Explore projects by interest">{categories.map(category=><a href={categoryUrl(base,category.id)}><span><span class={'interest-dot dot-'+category.id}></span>{category.name}</span><span class="interest-end"><span>{category.count}</span><Arrow size={15}/></span></a>)}</nav><a class="interest-all" href={base+'projects/'}>A little of everything <Arrow size={15}/></a></div>
  </section>
  <section class="featured-section container" id="work"><div class="section-heading"><div><p class="eyebrow">A GOOD PLACE TO START</p><h2>Selected work.</h2></div><a href={base+'projects/'} class="text-link">Browse the full collection <Arrow/></a></div><div class="featured-grid">{featuredProjects.map(project=><ProjectCard project={project} featured/>)}</div></section>
  <section class="learning-strip container"><div class="learning-symbol" aria-hidden="true">↗</div><div><p class="eyebrow">FOR THE CURIOUS</p><h2>Prefer to learn by doing?</h2><p>Explore interactive academies in PromQL, SPL, OpenTelemetry, GPU infrastructure, and Redfish.</p></div><a href={base+'learn/'} class="button button-secondary">Explore the academies <Arrow/></a></section>
  <section class="about-section container" id="about"><div><p class="eyebrow">THE PERSON BEHIND THE WORK</p><h2>Hi, I’m Siva.</h2></div><div class="about-copy"><p>{profile.about}</p><p class="about-secondary">Start with whatever sparks your curiosity. Each project has a short introduction and a path into the code, documentation, or public demo.</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">More on GitHub <Arrow diagonal/></a></div></section>
</Base>

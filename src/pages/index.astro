---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PortfolioIcon from '../components/PortfolioIcon.astro';
import { profile, projects, categories, academies, formats, categoryUrl, projectUrl } from '../data/portfolio';
import '../styles/home.css';
const base = import.meta.env.BASE_URL;
const findProject = (slug: string) => projects.find(project => project.slug === slug)!;
const categoryPicks: Record<string,string[]> = {
  observability: ['redfish-observability-lab','incidentlens','signalstory'],
  'ai-infrastructure': ['gpu-signal-atlas','llm-serving-observatory','inference-regression-lab'],
  systems: ['fleet-kernel-workbench','robotreplay','redfish-zero-to-hero'],
  sports: ['racetime-copilot','athlete-living-atlas','burro-race-replay'],
  community: ['hatti-quest','commonground-ai','nalam-tamil-wellness'],
};
const areaHeadings: Record<string,string> = {
  observability: 'From signals to understanding.',
  'ai-infrastructure': 'Look inside the infrastructure behind AI.',
  systems: 'Explore the layers beneath the application.',
  sports: 'Keep the evidence. Find the story.',
  community: 'Build for the conversations that matter.',
};
const featured = ['signalstory','gpu-signal-atlas','incidentlens','llm-serving-observatory','racetime-copilot','hatti-quest'].map(findProject);
const observability = categories.find(c=>c.id==='observability')!;
---
<Base pageClass="homepage" themeColor="#f2f7ff" title="Siva Babu — Software, systems & ideas" description="Explore Siva Babu’s tools, experiments, and learning projects across observability, AI infrastructure, systems, sport, and everyday life.">
  <section class="blue-hero" aria-labelledby="hero-title">
    <div class="container blue-hero-inner">
      <div class="hero-copy">
        <p class="blue-badge"><span aria-hidden="true"></span> SOFTWARE, SYSTEMS & IDEAS</p>
        <h1 id="hero-title">Curious ideas.<br/><span>Practical software.</span></h1>
        <p class="hero-description">I’m Siva Babu. I turn questions about systems, AI, learning, and everyday life into tools and experiments you can explore.</p>
        <div class="blue-actions"><a class="blue-button" href={base+'projects/'}>Explore projects <Arrow size={17}/></a><a class="white-button" href="#selected-work">See selected work <Arrow size={17}/></a></div>
      </div>
      <div class="portfolio-network" aria-label="A connected view of the portfolio">
        <div class="network-petals" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="network-ring" aria-hidden="true"><span class="ring-label ring-label-top">UNDERSTAND SYSTEMS</span><span class="ring-label ring-label-bottom">EXPLORE · BUILD · SHARE</span></div>
        <a class="network-core" href={base+'projects/'} aria-label={'Browse all '+projects.length+' public projects'}><span class="core-symbol" aria-hidden="true"><svg viewBox="0 0 72 72" fill="none"><path d="M17 45L35 24L55 44M17 45H55M35 24V54"/><circle cx="17" cy="45" r="5"/><circle cx="35" cy="24" r="5"/><circle cx="55" cy="44" r="5"/><circle cx="35" cy="54" r="5"/></svg></span><strong>{projects.length}</strong><span>public projects</span></a>
        <a class="floating-panel panel-signals" href={categoryUrl(base,'observability')}><span class="panel-kicker"><span class="panel-dot"></span> OBSERVABILITY <span aria-hidden="true">•••</span></span><div class="mini-wave" aria-hidden="true"><svg viewBox="0 0 155 35"><path d="M1 27L17 27L28 15L37 26L49 21L63 23L75 4L87 25L101 21L112 24L127 12L139 23L154 19"/></svg></div><div class="floating-bottom"><strong>{observability.count}</strong><span>projects to explore</span><Arrow diagonal size={14}/></div></a>
        <a class="floating-panel panel-atlas" href={projectUrl(base,'gpu-signal-atlas')}><span class="float-icon"><PortfolioIcon name="ai-infrastructure" size={22}/></span><span class="floating-project-title">GPU Signal Atlas</span><span class="floating-caption">Signals with context.</span><span class="panel-text-link">Explore the evidence <Arrow size={12}/></span></a>
        <a class="floating-panel panel-learning" href={base+'learn/'}><span class="learning-panel-icon"><PortfolioIcon name="learn" size={20}/></span><div><strong>{academies.length} academies</strong><span>Learn by changing things.</span></div><Arrow diagonal size={14}/></a>
        <a class="floating-panel panel-family" href={projectUrl(base,'hatti-quest')}><span class="family-panel-icon" aria-hidden="true">Aa</span><div><strong>Hatti Quest</strong><span>Language. Family. Play.</span></div><Arrow diagonal size={14}/></a>
      </div>
    </div>
  </section>
  <section class="portfolio-facts container" aria-label="Portfolio at a glance"><div><strong>{projects.length}</strong><span>Original public projects</span></div><div><strong>{categories.length}</strong><span>Areas of exploration</span></div><div><strong>{academies.length}</strong><span>Learning academies</span></div><div><strong>{formats.length}</strong><span>Ways to explore the work</span></div></section>

  <section class="area-section container" aria-labelledby="areas-title">
    <div class="blue-section-heading"><p class="blue-badge">THE COLLECTION</p><h2 id="areas-title">One portfolio.<br class="mobile-break"/> <span>Five directions.</span></h2><p>From infrastructure to everyday apps, choose the thread that interests you.</p></div>
    <div class="area-explorer" data-area-explorer>
      <div class="area-tabs" role="tablist" aria-label="Project categories" aria-orientation="vertical">{categories.map((category,index)=><button type="button" role="tab" id={'tab-'+category.id} aria-controls={'area-'+category.id} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-area={category.id}><span class="area-icon"><PortfolioIcon name={category.id} size={22}/></span><span>{category.name}<small>{category.count} projects</small></span><Arrow size={15}/></button>)}</div>
      <div class="area-panels">{categories.map((category,index)=><section class={'area-panel area-'+category.id} role="tabpanel" id={'area-'+category.id} aria-labelledby={'tab-'+category.id} tabindex="0" hidden={index!==0}><div class="area-panel-top"><span class="area-panel-icon"><PortfolioIcon name={category.id} size={27}/></span><span class="area-total">{category.count} public projects</span></div><h3>{areaHeadings[category.id]}</h3><p>{category.description}</p><div class="area-project-links">{categoryPicks[category.id].map(slug=>{const project=findProject(slug);return <a href={projectUrl(base,slug)}><span><strong>{project.title}</strong><small>{project.format} · {project.tags[0]}</small></span><Arrow diagonal size={17}/></a>})}</div><a class="blue-inline-link" href={categoryUrl(base,category.id)}>Browse all {category.count} projects <Arrow size={16}/></a></section>)}</div>
    </div>
    <noscript><p class="category-fallback">Browse by category: {categories.map(category=><a href={categoryUrl(base,category.id)}>{category.name}</a>)}</p></noscript>
  </section>

  <section class="showcase-section" id="selected-work" aria-labelledby="selected-title"><div class="container">
    <div class="blue-section-heading"><p class="blue-badge">SELECTED WORK</p><h2 id="selected-title">Take a closer look<br class="mobile-break"/> <span>at the ideas.</span></h2><p>Tools to investigate. Labs to experiment with. A few different ways to learn and connect.</p></div>
    <div class="showcase-grid">{featured.map(project=><article class={'showcase-card showcase-'+project.slug}>
      <a href={projectUrl(base,project.slug)} class={'project-scene scene-'+project.slug} aria-label={'Explore '+project.title}>
        {project.slug==='signalstory' && <><img src={base+'images/'+project.image} width={project.imageWidth} height={project.imageHeight} alt="SignalStory’s four-part learning journey in the Python studio" loading="lazy"/><span class="scene-caption">From the Python studio</span></>}
        {project.slug==='gpu-signal-atlas' && <div class="atlas-visual" aria-hidden="true"><span class="scene-eyebrow">A SIGNAL, WITH CONTEXT</span><span class="atlas-chip"><PortfolioIcon name="ai-infrastructure" size={48}/></span><div class="evidence-path"><span>Telemetry</span><i>→</i><span>Context</span><i>→</i><span>Evidence</span></div><span class="scene-caption">Concept view</span></div>}
        {project.slug==='incidentlens' && <div class="incident-visual" aria-hidden="true"><div class="incident-sources"><span>Metrics</span><span>Logs</span><span>Traces</span></div><svg viewBox="0 0 250 65"><path d="M34 1v20Q34 35 60 35H125M125 1v63M215 1v20Q215 35 190 35H125"/></svg><span class="incident-evidence">Follow the evidence <Arrow size={15}/></span><span class="scene-caption">Investigation concept</span></div>}
        {project.slug==='llm-serving-observatory' && <div class="serving-visual" aria-hidden="true"><span class="scene-eyebrow">INSIDE THE REQUEST</span><div class="serving-stages"><span>Prefill</span><i>→</i><span>Decode</span></div><div class="cache-blocks"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><small>KV cache · Memory · Telemetry</small><span class="scene-caption">Serving concept</span></div>}
        {project.slug==='racetime-copilot' && <div class="race-visual" aria-hidden="true"><span class="scene-eyebrow">FIND THE MOMENT</span><PortfolioIcon name="sports" size={42}/><div class="race-timeline"><span></span><span></span><span></span><span></span><span></span><span></span><i></i></div><small>Coverage → Evidence → Catch-up</small><span class="scene-caption">Workflow concept</span></div>}
        {project.slug==='hatti-quest' && <><img src={base+'images/'+project.image} width={project.imageWidth} height={project.imageHeight} alt="A language-learning adventure in Hatti Quest" loading="lazy"/><span class="scene-caption">A detail from the adventure</span></>}
        <span class="scene-open" aria-hidden="true"><Arrow diagonal size={18}/></span>
      </a>
      <div class="showcase-copy"><p class="showcase-category"><PortfolioIcon name={project.categoryId} size={15}/>{project.categoryShort}<span>{project.format}</span></p><h3><a href={projectUrl(base,project.slug)}>{project.title}</a></h3><p class="showcase-description">{project.description}</p><a class="showcase-link" href={projectUrl(base,project.slug)}>Explore project <Arrow size={16}/></a></div>
    </article>)}</div>
    <div class="showcase-all"><a class="blue-button" href={base+'projects/'}>Browse all {projects.length} projects <Arrow size={17}/></a></div>
  </div></section>

  <section class="academy-section container" aria-labelledby="academy-title"><div class="academy-intro"><p class="blue-badge">LEARN BY DOING</p><h2 id="academy-title">Change something.<br/><span>See what happens.</span></h2><p>Learning projects that make technical ideas visible. Explore queries, traces, hardware, and infrastructure through practical exercises.</p><a class="blue-inline-link" href={base+'learn/'}>Explore the learning collection <Arrow size={17}/></a></div><div class="academy-links">{academies.map(project=><a href={projectUrl(base,project.slug)}><span class="academy-icon"><PortfolioIcon name="learn" size={19}/></span><span>{project.title}<small>{project.tags[0]}</small></span><Arrow diagonal size={15}/></a>)}</div></section>

  <section class="blue-about" id="about" aria-labelledby="about-title"><div class="container blue-about-inner"><p class="blue-badge">THE PERSON BEHIND THE PROJECTS</p><h2 id="about-title">Hi, I’m Siva.<br/><span>Always another question to explore.</span></h2><p>My work moves between infrastructure, visual learning, sport, and language. The common thread is wanting to understand things better, build something useful, and share the work along the way.</p><a class="blue-button" href={profile.github} target="_blank" rel="noopener noreferrer">Find me on GitHub <Arrow diagonal size={17}/></a></div></section>
  <script>
    const explorer = document.querySelector<HTMLElement>('[data-area-explorer]');
    if (explorer) {
      const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const tablist = explorer.querySelector<HTMLElement>('[role="tablist"]');
      function selectArea(index: number, focus = false) {
        tabs.forEach((tab,i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        panels.forEach((panel,i) => { panel.hidden = i !== index; });
        if (focus) tabs[index].focus();
      }
      tabs.forEach((tab,index) => {
        tab.addEventListener('click',()=>selectArea(index));
        tab.addEventListener('keydown',event=>{
          let next = index;
          if (event.key==='ArrowDown'||event.key==='ArrowRight') next=(index+1)%tabs.length;
          else if (event.key==='ArrowUp'||event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
          else if (event.key==='Home') next=0;
          else if (event.key==='End') next=tabs.length-1;
          else return;
          event.preventDefault();selectArea(next,true);
        });
      });
      const phone = window.matchMedia('(max-width:760px)');
      const updateOrientation = () => tablist?.setAttribute('aria-orientation', phone.matches ? 'horizontal' : 'vertical');
      updateOrientation();phone.addEventListener('change',updateOrientation);
    }
  </script>
</Base>

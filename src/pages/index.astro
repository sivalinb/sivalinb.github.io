---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PortfolioIcon from '../components/PortfolioIcon.astro';
import SignalJourney from '../components/SignalJourney.astro';
import { profile, projects, categories, academies, categoryUrl, projectUrl } from '../data/portfolio';
import { featuredWork, strengths, experience, categoryPicks } from '../data/career';
import '../styles/home.css';
import '../styles/redesign.css';
const base = import.meta.env.BASE_URL;
const findProject = (slug: string) => projects.find(project => project.slug === slug)!;
const work = featuredWork.map(item => ({ ...item, project: findProject(item.slug) }));
const personal = ['nanga-hatti', 'racetime-copilot'].map(findProject);
const communityBuild = findProject('badaga-care-circle');
const restorativeBuild = findProject('circlepath-rj');
const learning = ['promql-zero-to-hero', 'opentelemetry-zero-to-hero', 'gpu-infrastructure-zero-to-hero'].map(findProject);
---
<Base pageClass="homepage professional-home" themeColor="#090f1d" title="Siva Babu — AI Infrastructure & Observability" description={profile.introduction}>
  <section class="pro-hero" aria-labelledby="hero-title">
    <div class="container pro-hero-grid">
      <div class="pro-hero-copy">
        <p class="pro-eyebrow"><span aria-hidden="true"></span> SIVA BABU / SOFTWARE ENGINEERING</p>
        <h1 id="hero-title">Building reliable<br/><span>AI infrastructure.</span></h1>
        <p class="pro-intro">I’m Siva, a software engineer with 20+ years across production infrastructure, observability and fleet operations. I connect telemetry architecture, useful workload performance and safe fleet operations—with engineering decisions and execution evidence you can inspect.</p>
        <div class="pro-actions"><a class="pro-button primary" href="#selected-work">View selected work <Arrow size={18}/></a><a class="pro-button ghost" href="#experience">My experience <Arrow size={18}/></a></div>
        <div class="pro-career-line"><span>EXPERIENCE ACROSS</span><strong>Apple</strong><i aria-hidden="true"></i><strong>Oracle</strong><span class="pro-career-more">Production systems since 2005</span></div>
      </div>
      <figure class="hero-system">
        <div class="system-label"><span>FROM THE WORKBENCH</span><span>01 / DATA HALL → GPU</span></div>
        <a href={projectUrl(base,'grafana-data-center-explorer')} aria-label="Explore the Grafana data hall view"><img src={base+'images/grafana-data-hall.jpg'} width="1280" height="1127" alt="Grafana Business Text data hall view with a thermal floor plan, 24 racks and a cooling incident" fetchpriority="high"/></a>
        <figcaption><span>Data Center Explorer · data hall</span><span>Grafana Business Text · synthetic telemetry <Arrow diagonal size={14}/></span></figcaption>
      </figure>
    </div>
    <div class="container hero-bottom"><span>AI systems. Clear signals. Recoverable operations.</span><a href={base+'projects/'}>Explore all {projects.length} projects <Arrow size={17}/></a></div>
  </section>

  <section class="container pro-intro-strip" aria-label="Professional focus">
    <div><strong>20+<span>years</span></strong><p>Production infrastructure<br/>and software engineering</p></div>
    <div><strong>{projects.length}<span>projects</span></strong><p>Independent work<br/>with inspectable source</p></div>
    <div><strong>{academies.length}<span>academies</span></strong><p>Technical ideas<br/>made tangible</p></div>
    <p class="strip-note">My work lives at the intersection of <b>AI infrastructure, observability and reliability.</b></p>
  </section>

  <SignalJourney />

  <section class="container selected-systems" id="selected-work" aria-labelledby="work-title">
    <div class="pro-section-heading"><div><p class="pro-eyebrow">SELECTED INDEPENDENT PROJECTS</p><h2 id="work-title">The work behind the skills.</h2></div><p>Systems you can inspect, experiments you can reproduce, and engineering decisions you can follow.</p></div>
    <div class="systems-grid">{work.map((item,index)=><article class:list={['system-card',{'flagship':index<2}]}>
      <a class={'system-visual visual-'+item.project.slug} href={projectUrl(base,item.project.slug)} aria-label={'Explore '+item.project.title}>
        <img src={base+'images/'+item.project.image} width={item.project.imageWidth} height={item.project.imageHeight} alt={item.project.imageKind+' for '+item.project.title} loading="lazy"/>
        <span class="visual-caption">{item.caption}<Arrow diagonal size={16}/></span>
      </a>
      <div class="system-copy"><p class="system-kicker"><span>{String(index+1).padStart(2,'0')} / {item.focus}</span><span>{item.project.format}</span></p><h3><a href={projectUrl(base,item.project.slug)}>{item.project.title}</a></h3><p class="system-summary">{item.summary}</p><div class="demonstrates"><span>WHAT THIS DEMONSTRATES</span><p>{item.demonstrates}</p></div><ul class="system-stack" aria-label="Project technologies">{item.stack.map(tool=><li>{tool}</li>)}</ul><div class="system-actions"><a href={projectUrl(base,item.project.slug)}>Explore the project <Arrow size={16}/></a><a href={item.project.repository} target="_blank" rel="noopener noreferrer" aria-label={'View '+item.project.title+' source on GitHub'}>Source <Arrow diagonal size={15}/></a></div></div>
    </article>)}</div>
    <div class="collection-link"><span>A selection from {projects.length} original public projects.</span><a class="pro-button outline" href={base+'projects/'}>Browse the complete collection <Arrow size={17}/></a></div>
  </section>

  <section class="skills-section" id="skills" aria-labelledby="skills-title"><div class="container">
    <div class="pro-section-heading"><div><p class="pro-eyebrow">ENGINEERING STRENGTHS</p><h2 id="skills-title">Depth across the stack.</h2></div><p>From Linux signals to fleet operations and inference performance. Each strength connects to concrete work.</p></div>
    <div class="strength-grid">{strengths.map(strength=><article><span class="strength-icon"><PortfolioIcon name={strength.icon} size={27}/></span><h3>{strength.title}</h3><p>{strength.text}</p><span class="strength-tools">{strength.tools}</span><div class="strength-proof">{strength.proof.map(slug=><a href={projectUrl(base,slug)}>{findProject(slug).title}<Arrow diagonal size={13}/></a>)}</div></article>)}</div>
  </div></section>

  <section class="container collection-section" aria-labelledby="collection-title">
    <div class="pro-section-heading"><div><p class="pro-eyebrow">EXPLORE BY INTEREST</p><h2 id="collection-title">Follow your thread.</h2></div><a class="text-link" href={base+'projects/'}>All {projects.length} projects <Arrow size={16}/></a></div>
    <div class="area-explorer" data-area-explorer>
      <div class="area-tabs" role="tablist" aria-label="Project categories" aria-orientation="vertical">{categories.map((category,index)=><button type="button" role="tab" id={'tab-'+category.id} aria-controls={'area-'+category.id} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1}><span class="area-icon"><PortfolioIcon name={category.id} size={22}/></span><span>{category.name}<small>{category.count} projects</small></span><Arrow size={15}/></button>)}</div>
      <div class="area-panels">{categories.map((category,index)=><section class="area-panel" role="tabpanel" id={'area-'+category.id} aria-labelledby={'tab-'+category.id} tabindex="0" hidden={index!==0}><p class="pro-eyebrow">{category.short} / {category.count} PROJECTS</p><h3>{category.name}</h3><p>{category.description}</p><div class="area-project-links">{categoryPicks[category.id].map(slug=>{const project=findProject(slug);return <a href={projectUrl(base,slug)}><span><strong>{project.title}</strong><small>{project.format} · {project.tags[0]}</small></span><Arrow diagonal size={16}/></a>})}</div><a class="text-link" href={categoryUrl(base,category.id)}>Browse all {category.count} projects <Arrow size={16}/></a></section>)}</div>
    </div>
    <noscript><p class="category-fallback">Browse by category: {categories.map(category=><a href={categoryUrl(base,category.id)}>{category.name}</a>)}</p></noscript>
  </section>

  <section class="experience-section" id="experience" aria-labelledby="experience-title"><div class="container experience-grid">
    <div class="experience-intro"><p class="pro-eyebrow">PRODUCTION EXPERIENCE</p><h2 id="experience-title">Built over time.<br/>Grounded in practice.</h2><p>Software engineering and operations across AI infrastructure, enterprise platforms and production systems.</p><div class="experience-foundation"><span>FOUNDATION</span><strong>B.E. Computer Science & Engineering</strong><p>Bharathiar University, India</p></div></div>
    <div class="experience-timeline">{experience.map(job=><article><div class="job-top"><h3>{job.company}</h3><span>{job.period}</span></div><p class="job-role">{job.role}</p><span class="job-context">{job.context}</span><p class="job-description">{job.text}</p></article>)}</div>
  </div></section>

  <section class="container personal-section" id="about" aria-labelledby="personal-title">
    <div class="pro-section-heading"><div><p class="pro-eyebrow">A LITTLE MORE HUMAN</p><h2 id="personal-title">There’s life beyond the cluster.</h2></div><p>I’m also an ultramarathon runner, running coach and trained restorative-justice facilitator. Some projects begin with those parts of life.</p></div>
    <article class="care-feature circlepath-feature" aria-labelledby="circlepath-build-title">
      <div class="care-feature-copy"><p class="pro-eyebrow">LATEST COMMUNITY BUILD / RESTORATIVE JUSTICE</p><h3 id="circlepath-build-title"><a href={projectUrl(base,restorativeBuild.slug)}>{restorativeBuild.title}</a></h3><p>A prepared team. A clear next step. Built from the coordination problems I see as a restorative-justice facilitator: role signup, preparation, meetings, repair follow-up and reintegration.</p><div class="care-proof-facts"><span>Live Gemini drafts</span><span>Human review</span><span>Arize + OpenTelemetry</span></div><p class="care-feature-note">The local Gradio demo connects reviewed drafts to real workflow rules and Grafana signals. Case inputs are fictional; consent, repair agreements and outcomes remain human decisions.</p><div class="care-feature-actions"><a class="pro-button primary" href={projectUrl(base,restorativeBuild.slug)}>Explore the case study <Arrow size={16}/></a><a class="text-link" href={restorativeBuild.repository} target="_blank" rel="noopener noreferrer">Source & local demo <Arrow diagonal size={16}/></a></div></div>
      <figure class="care-proof-image circlepath-workflow"><a href={projectUrl(base,restorativeBuild.slug)} aria-label="Explore CirclePath’s restorative workflow and bounded AI architecture"><img src={base+'images/circlepath-workflow.svg'} width="1320" height="960" loading="lazy" alt="CirclePath workflow from case review to reintegration, with source validation and human review before actions"/></a><figcaption>Architecture illustration · working local demo</figcaption></figure>
    </article>
    <article class="care-feature" aria-labelledby="community-build-title">
      <div class="care-feature-copy"><p class="pro-eyebrow">COMMUNITY CARE / ENGLISH & TAMIL</p><h3 id="community-build-title"><a href={projectUrl(base,communityBuild.slug)}>{communityBuild.title}</a></h3><p>Care for the people everyone depends on. A Python and Gradio demo connects bilingual education, human review, shared caregiving and family backup plans.</p><div class="care-proof-facts"><span>53 Python tests</span><span>46 synthetic eval cases</span><span>Fictional-data demo</span></div><p class="care-feature-note">The local app’s actual screenshots, request traces and exported results make its behavior inspectable. Clinical and Tamil-language approvals remain pending.</p><div class="care-feature-actions"><a class="pro-button primary" href={projectUrl(base,communityBuild.slug)}>Explore the case study <Arrow size={16}/></a><a class="text-link" href={communityBuild.repository+'#working-evidence-actual-screens-and-downloadable-results'} target="_blank" rel="noopener noreferrer">Working evidence <Arrow diagonal size={16}/></a></div></div>
      <figure class="care-proof-image"><a href={projectUrl(base,communityBuild.slug)+'#working-evidence'} aria-label="Inspect Badaga Care Circle evaluation and observability screenshots"><img src={base+'images/badaga-care-circle-metrics.jpg'} width="531" height="552" loading="lazy" alt="Actual Gradio metrics from six fictional requests, with provider counts, fallback states and zero external token usage"/></a><figcaption>Actual Gradio capture · fictional inputs</figcaption></figure>
    </article>
    <div class="personal-grid">{personal.map(project=><article><a class="personal-image" href={projectUrl(base,project.slug)} aria-label={'Explore '+project.title}><img src={base+'images/'+project.image} width={project.imageWidth} height={project.imageHeight} alt={project.imageKind+' for '+project.title} loading="lazy"/><span>{project.slug==='nanga-hatti'?'Public explorer · fictional starter memories':'Project workflow illustration'}</span></a><div><p class="pro-eyebrow">{project.slug==='nanga-hatti'?'COMMUNITY & MEMORY':'RUNNING & EVIDENCE'}</p><h3><a href={projectUrl(base,project.slug)}>{project.title}</a></h3><p>{project.description}</p><a class="text-link" href={projectUrl(base,project.slug)}>Explore the story <Arrow size={16}/></a></div></article>)}</div>
  </section>

  <section class="learning-section"><div class="container learning-grid"><div><p class="pro-eyebrow">LEARN BY DOING</p><h2>Make the ideas tangible.</h2><p>{academies.length} technical academies for exploring queries, instrumentation, hardware and serving systems.</p><a class="text-link" href={base+'learn/'}>Explore all academies <Arrow size={17}/></a></div><div class="learning-links">{learning.map(project=><a href={projectUrl(base,project.slug)}><span><PortfolioIcon name="learn" size={21}/>{project.title}</span><Arrow diagonal size={17}/></a>)}</div></div></section>

  <section class="container pro-contact" aria-labelledby="contact-title"><div><p class="pro-eyebrow">LET’S CONNECT</p><h2 id="contact-title">A good system starts<br/>with a good conversation.</h2></div><div><p>Interested in AI infrastructure, observability or reliability engineering? Explore the source and get in touch.</p><a class="pro-button primary" href={profile.email?'mailto:'+profile.email:profile.github} target={profile.email?undefined:'_blank'} rel={profile.email?undefined:'noopener noreferrer'}>{profile.email?'Say hello':'Find me on GitHub'} <Arrow diagonal size={18}/></a></div></section>
  <script>
    const explorer = document.querySelector<HTMLElement>('[data-area-explorer]');
    if (explorer) {
      const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const tablist = explorer.querySelector<HTMLElement>('[role="tablist"]');
      const selectArea = (index: number, focus=false) => {
        tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});
        panels.forEach((panel,i)=>{panel.hidden=i!==index;});
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab,index)=>{
        tab.addEventListener('click',()=>selectArea(index));
        tab.addEventListener('keydown',event=>{
          let next=index;
          if (event.key==='ArrowDown'||event.key==='ArrowRight') next=(index+1)%tabs.length;
          else if (event.key==='ArrowUp'||event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
          else if (event.key==='Home') next=0;
          else if (event.key==='End') next=tabs.length-1;
          else return;
          event.preventDefault();selectArea(next,true);
        });
      });
      const phone=window.matchMedia('(max-width:760px)');
      const update=()=>tablist?.setAttribute('aria-orientation',phone.matches?'horizontal':'vertical');
      update();phone.addEventListener('change',update);
    }
  </script>
</Base>

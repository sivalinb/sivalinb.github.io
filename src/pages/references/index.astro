---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { references } from '../../data/portfolio';
---
<Base title="References & upstream forks — Siva Babu" description="Upstream projects forked in Siva Babu's GitHub account, shown with clear attribution.">
  <section class="page-heading container"><p class="eyebrow">UPSTREAM REFERENCES</p><h1>Standing on good foundations.</h1><p>These are forks of upstream projects in my GitHub account.<br class="desktop-break"/> Their original authors deserve the credit.</p></section>
  <section class="container references-section"><div class="reference-list">{references.map(reference=><article><div><span class="format-label">Upstream fork</span><h2>{reference.title}</h2><p>{reference.description}</p></div><a href={reference.repository} class="button button-secondary" target="_blank" rel="noopener noreferrer">View fork <Arrow diagonal/></a></article>)}</div><a class="text-link" href={import.meta.env.BASE_URL+'projects/'}>Explore my original projects <Arrow/></a></section>
</Base>
